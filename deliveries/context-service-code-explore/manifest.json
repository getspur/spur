  "claims": [
    {
      "claim_id": "C01",
      "text": "SPUR Context Service is cloud code context for third-party packages.",
      "source_asset_ids": ["src-web-context", "src-product-usage"]
    },
    {
      "claim_id": "C02",
      "text": "Code has edges that leave the worktree; without external context, agents guess dependency APIs.",
      "source_asset_ids": ["src-web-context", "src-product-usage"]
    },
    {
      "claim_id": "C03",
      "text": "Worktree tools answer what is in this repo, while external tools answer what is in a dependency at a pinned version.",
      "source_asset_ids": ["src-web-context", "src-product-usage"]
    },
    {
      "claim_id": "C04",
      "text": "The worktree plane uses knowledge_context_pack_2 and code_* tools.",
      "source_asset_ids": ["src-web-context", "src-product-usage"]
    },
    {
      "claim_id": "C05",
      "text": "The external plane uses external_* MCP tools served by Context Service.",
      "source_asset_ids": ["src-web-context", "src-product-usage"]
    },
    {
      "claim_id": "C06",
      "text": "Without structured external context, agents fall back to web search, outdated docs, or API guesses across versions.",
      "source_asset_ids": ["src-web-context", "src-product-usage"]
    },
    {
      "claim_id": "C07",
      "text": "Wrong dependency assumptions cause broken integrations, missed breaking changes, and rework.",
      "source_asset_ids": ["src-web-context", "src-product-usage"]
    },
    {
      "claim_id": "C08",
      "text": "Indexed unit identity is source, package, and revision; a pkg selector pins the dependency version.",
      "source_asset_ids": ["src-web-context", "src-product-usage"]
    },
    {
      "claim_id": "C09",
      "text": "The graph-first loop orients with external_knowledge_context, reads source, follows callers and callees, and indexes cold revisions with status polling.",
      "source_asset_ids": ["src-web-context", "src-product-usage"]
    },
    {
      "claim_id": "C10",
      "text": "External context complements local intelligence; pkg selectors should not be mixed into worktree code_* reads.",
      "source_asset_ids": ["src-web-context", "src-product-usage"]
    },
    {
      "claim_id": "C11",
      "text": "Context Service provides version-precise answers without cloning every crate while preserving a graph-first workflow.",
      "source_asset_ids": ["src-web-context", "src-product-usage"]
    }
  ],
