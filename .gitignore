/target
# Per-crate target dirs (for excluded workspace members like spur-context-service)
crates/*/target
# Generated by `scripts/spur-cargo coverage` (cargo-llvm-cov lcov output) —
# deliberately NOT under target/, since target/ is excluded from the VM->local
# sync-back that `spur-cargo run` uses.
coverage/
*.ducklake
.spur/worktrees/
.worktrees/
*.db
.idea/
.DS_Store
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Local env files — never commit (Buffer tokens, R2 keys, etc.)
.env
.env.local
.env.*.local
local.env
*.local.env
python/dist/
__pycache__/

# cargo xtask dist output (release binaries + SHA256SUMS)
/dist/
**/.spur-venv/

# bv (beads viewer) local config and caches
.bv/
**/.spur/events/**
**/.spur/logs/**
/.spur/graph-index.json
**/.spur/graph-index.json
.spur/graph/
.spur/explore/cache/
.spur/solver/
.spur/commit-index.json
.spur/commit-index.pointer.json
.spur/graph-index.pointer.json
**/.spur/pgids/**
.spur/session_metadata.json
**/.spur/session_metadata.json
**/.spur/session_metadata.json.tmp
.spur/loop-runtime.lock
**/.spur/analyst*/**
**/.spur/analyst-overlays/**
.spur/bot/
.spur/keys/
# Ephemeral build/install scratch (cargo target dirs from ext harnesses, etc.)
.spur/tmp/
**/.spur/tmp/
/.beads/
/resource/superpowers/
.superpowers/brainstorm/
/.spur/sessions/**
.spur/analyst.duckdb*

# Operator-local .spur noise (never product). Keep config.toml.example + skills/.
.spur/config.toml
.spur/remote-cargo.enabled
.spur/s3-*
.spur/s4-*
.spur/*.log
.spur/*.log.*

# spur pm (beads) — derived files; commit issues.jsonl
.beads/beads.db
.beads/beads.db-*
.beads/.write.lock
.beads/issues.jsonl.*.tmp

# node deps — never track or sync (rebuilt locally; build VM enumerates --others)
node_modules/

# local model + scratch caches
.fastembed_cache/
.tmp/

# tool & IDE caches
.antigravitycli/
.wrangler/
.zed/

# loose logs and patches at repo root
/*.log
spur.log.*
/*.patch
/resources/

# growth-loop artifacts
/resource/growth-loop/

# local pnpm store (created when spur-pnpm falls back to local mode; use the VM store)
/.pnpm-store/
crates/spur-context-service/Cargo.lock

# VHS TUI e2e generated outputs
/scripts/e2e/.artifacts/
/scripts/e2e/vhs/actual/
/scripts/e2e/vhs/tmp/

# downloaded binary in local npm wrapper test runs
npm/spur-cli/bin/
infra/spur-context-service/local-live-sync.tfvars
# Operator-local Terraform values (account/image pins). Use env/*.tfvars +
# TF_VAR_* for secrets. Never commit real terraform.tfvars / *.auto.tfvars.
infra/spur-context-service/terraform.tfvars
infra/spur-context-service/*.auto.tfvars

# ---------------------------------------------------------------------------
# OSS boundary — not part of the public product tree
# Local copies may remain on disk for company ops; only pointer READMEs are
# tracked where noted. Sibling homes: getspur/spur-marketing, spur-media (planned).
# ---------------------------------------------------------------------------

# GTM / campaign / competitor research (private marketing tree)
/marketing/**
!/marketing/README.md

# Launch films, HyperFrames projects, explainer deliveries
/videos/**
!/videos/README.md
/deliveries/**
!/deliveries/README.md
/video-assets/
/docs/product_launch/**
!/docs/product_launch/README.md

# One-off migration / screenshot dumps
/output/

# Local-only app / SDK checkouts (not monorepo product)
/app_gallery/
/sdk/

# Accidental root npm / skill lock from media tooling
/package.json
/package-lock.json
/skills-lock.json
