/target
.spur/worktrees/
.worktrees/
*.db
.idea/
.DS_Store
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Local env files — never commit (Buffer tokens, R2 keys, etc.)
.env
.env.local
.env.*.local
python/dist/
__pycache__/

# bv (beads viewer) local config and caches
.bv/
**/.spur/events/**
**/.spur/logs/**
/.spur/graph-index.json
**/.spur/graph-index.json
**/.spur/pgids/**
.spur/session_metadata.json
**/.spur/session_metadata.json
**/.spur/session_metadata.json.tmp
.spur/bot/
.spur/keys/
/.beads/
/resource/superpowers/
.superpowers/brainstorm/
/.spur/sessions/**

# Vendored marketing skills — ignore everything except SKILL.md files (so worker
# worktrees can resolve them) and the upstream LICENSE / README.
marketing/marketingskills/*
!marketing/marketingskills/skills/
marketing/marketingskills/skills/*/*
!marketing/marketingskills/skills/*/SKILL.md
!marketing/marketingskills/LICENSE
!marketing/marketingskills/README.md
.spur/analyst.duckdb*
