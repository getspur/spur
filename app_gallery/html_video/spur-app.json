{
  "schema": "spur.app/v1",
  "name": "HTML Video",
  "entry_notebook": "app.ipynb",
  "open_mode": "app",
  "runtime": {
    "jute_min": "0.1.0",
    "features": [
      "frontend-cells",
      "anywidget-afm",
      "mcp-tools",
      "ports-arrow"
    ]
  },
  "dependencies": {
    "python": "server/requirements.txt"
  },
  "mcp_server": {
    "type": "python",
    "entry": "server/main.py",
    "requirements": "server/requirements.txt",
    "env": {}
  },
  "widgets": [],
  "ports": null,
  "capabilities": {
    "ports": {
      "read": ["spur-ad-capture"],
      "write": []
    },
    "canvas_capture": true,
    "active_output_scripts": true,
    "artifacts_dir": true
  },
  "skill": "skill/SKILL.md",
  "sdk": {
    "typescript": "sdk"
  }
}