{
  "schema": "spur.app/v1",
  "name": "Open Design",
  "entry_notebook": "app.ipynb",
  "open_mode": "app",
  "runtime": {
    "jute_min": "0.1.0",
    "features": [
      "frontend-cells",
      "mcp-tools"
    ]
  },
  "dependencies": {},
  "widgets": [],
  "ports": null,
  "capabilities": {
    "active_output_scripts": false,
    "canvas_capture": false,
    "artifacts_dir": true
  },
  "skill": "skill/SKILL.md",
  "library": {
    "env_var": "SPUR_OPEN_DESIGN_LIBRARY",
    "root": "library",
    "design_systems": "library/open-design-library",
    "deck_themes": "library/open-design-deck-library",
    "skill_catalog": "library/skill-catalog"
  }
}
