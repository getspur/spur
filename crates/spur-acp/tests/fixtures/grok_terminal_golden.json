      "canonical": {
        "command": "/bin/bash",
        "args": [
          "-c",
          "python3 -c 'import json; print(json.dumps({\"pipe\": \"a|b\", \"quote\": \"say \\\"hi\\\"\", \"unicode\": \"世界\"}, ensure_ascii=False, sort_keys=True))'"
        ]
      },
      "packed": [
        {
          "command": "/bin/bash -c 'python3 -c '\"'\"'import json; print(json.dumps({\"pipe\": \"a|b\", \"quote\": \"say \\\"hi\\\"\", \"unicode\": \"世界\"}, ensure_ascii=False, sort_keys=True))'\"'\"''",
          "args": []
        },
        {
          "command": "/bin/bash -c \"python3 -c 'import json; print(json.dumps({\\\"pipe\\\": \\\"a|b\\\", \\\"quote\\\": \\\"say \\\\\\\"hi\\\\\\\"\\\", \\\"unicode\\\": \\\"世界\\\"}, ensure_ascii=False, sort_keys=True))'\"",
          "args": []
        }
      ],
      "expected": {
        "stdout": "{\"pipe\": \"a|b\", \"quote\": \"say \\\"hi\\\"\", \"unicode\": \"世界\"}\n",
        "exit_code": 0,
        "stderr": ""
      }
