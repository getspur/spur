  "cases": [
    {
      "id": "bash_printf",
      "requires": [],
      "files": {},
      "env": {},
      "canonical": {
        "command": "/bin/bash",
        "args": [
          "-c",
          "printf 'shell-ok\\n'"
        ]
      },
      "packed": [
        {
          "command": "/bin/bash -c 'printf '\"'\"'shell-ok\\n'\"'\"''",
          "args": []
        },
        {
          "command": "/bin/bash -c \"printf 'shell-ok\\\\n'\"",
          "args": []
        }
      ],
      "expected": {
        "stdout": "shell-ok\n",
        "exit_code": 0,
        "stderr": ""
      }
    },
