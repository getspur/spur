# Example variables. Copy this shape into env/<environment>.tfvars or an
# uncommitted override file; deploy.sh passes env/staging.tfvars by default.
# Do not commit real account, network, image, or secret values.
#
# Lambda configuration
lambda_memory_mb          = 2048
lambda_timeout_sec        = 30
concurrent_warm_instances = 1

# Public API abuse controls
api_throttle_rate_limit                  = 20
api_throttle_burst_limit                 = 40
index_rate_limit_per_minute              = 10
index_max_concurrent_jobs_per_caller     = 2

# Bounded backlog. Queue caps remain zero until an operator deliberately opts
# in; the scheduled one-minute drainer is still installed as the correctness
# path so enabling queueing cannot strand accepted work.
index_queue_shard_count                = 16
index_max_running_jobs_per_owner       = null
index_max_queued_jobs_per_owner        = 0
index_max_running_jobs_global          = 0
index_max_queued_jobs_global           = 0
index_drainer_batch_limit              = 8
index_drainer_scan_limit_per_shard     = 32
index_drainer_schedule_rate_minutes    = 1

context_max_tarball_bytes                = 524288000
context_max_git_bytes                    = 2147483648
context_max_build_seconds                = 1800
allowed_source_domains                   = []

# Personal API-key authentication is additive and disabled by default. Enable
# it only alongside a fully configured Cognito human client. The authorizer and
# cleanup zips are independent lean artifacts; neither may reuse the serving
# Lambda zip. Build both exact paths with
# scripts/package-context-api-key-lambdas.sh from the repository root. No raw
# API key belongs in tfvars or Terraform state.
api_key_auth_enabled                  = false
# Enabling this feature also requires Cognito configuration with
# cognito_human_callback_urls containing the exact registered CLI callback:
# ["http://127.0.0.1:8765/callback"]
api_key_authorizer_zip_path           = "../../target/lambda/spur-context-api-key-authorizer.zip"
api_key_cleanup_zip_path              = "../../target/lambda/spur-context-api-key-cleanup.zip"
api_key_environment                   = "live"
api_key_authorizer_cache_seconds      = 30
api_key_default_ttl_days              = 90
api_key_max_ttl_days                  = 365
api_key_max_active_per_user           = 10
api_key_authorizer_memory_mb          = 256
api_key_authorizer_timeout_sec        = 5
api_key_authorizer_log_retention_days = 14
api_key_cleanup_memory_mb             = 256
api_key_cleanup_timeout_sec           = 60
api_key_cleanup_log_retention_days    = 14
api_key_cleanup_max_catchup_hours     = 168
api_key_cleanup_schedule_minutes      = 5
api_key_cleanup_max_buckets           = 4
api_key_cleanup_max_pages             = 8
api_key_cleanup_max_records           = 100
api_key_cleanup_page_limit            = 100
api_key_cleanup_cursor_lag_alarm_hours = 2
api_key_alarm_action_arns              = []

# On-demand indexing — required for v2
# VPC where workers run in private subnets. By default this module creates
# NAT-free VPC endpoints for AWS service egress.
vpc_id = "vpc-xxxxxxxx"

# Private subnets for the Lambda worker and ECS fallback worker.
worker_subnets = [
  "subnet-xxxxxxxx",
  "subnet-yyyyyyyy",
]

# Optional interface endpoint ENI subnets. Use one subnet for lower-cost dev
# stacks, or leave empty to create endpoint ENIs in all worker_subnets.
interface_vpc_endpoint_subnet_ids = [
  "subnet-xxxxxxxx",
]

# Low-cost Lambda-worker endpoint set. Add ecr_api, ecr_dkr, logs, and sts
# when private ECS fallback tasks must pull from ECR and emit logs without NAT.
interface_vpc_endpoint_service_keys = [
  "states",
  "secretsmanager",
]

# Route table IDs associated with worker_subnets. Required for the default
# S3 and DynamoDB gateway endpoints.
worker_route_table_ids = [
  "rtb-xxxxxxxx",
  "rtb-yyyyyyyy",
]

# Set false only when these subnets already have NAT or equivalent shared VPC
# endpoints for the AWS services selected by interface_vpc_endpoint_service_keys
# plus S3 and DynamoDB gateway access.
create_vpc_endpoints = true

# Optional service-name region override for VPC endpoints. Defaults to
# aws_region.
# vpc_endpoint_region = "ap-southeast-5"

# ECR cleanup for worker images. The lifecycle policy expires untagged images
# after 7 days and keeps the newest 10 tagged images in each context-service
# repository.
manage_ecr_lifecycle_policies   = true
ecr_lifecycle_repository_names = [
  "spur-context-worker",
  "spur-context-worker-lambda",
  "spur-context-source-fetcher",
]
ecr_lifecycle_keep_tagged_images  = 10
ecr_lifecycle_untagged_image_days = 7

# ECR images for the indexing workers. Built and pushed by deploy.sh, or
# manually:
#   docker build -t <acct>.dkr.ecr.<region>.amazonaws.com/spur-context-worker:latest .
#   docker push <acct>.dkr.ecr.<region>.amazonaws.com/spur-context-worker:latest
#   docker build -t <acct>.dkr.ecr.<region>.amazonaws.com/spur-context-worker-lambda:latest .
#   docker push <acct>.dkr.ecr.<region>.amazonaws.com/spur-context-worker-lambda:latest
#   docker build -t <acct>.dkr.ecr.<region>.amazonaws.com/spur-context-source-fetcher:latest .
#   docker push <acct>.dkr.ecr.<region>.amazonaws.com/spur-context-source-fetcher:latest
worker_ecr_image            = "123456789012.dkr.ecr.ap-southeast-5.amazonaws.com/spur-context-worker:latest"
worker_lambda_image         = "123456789012.dkr.ecr.ap-southeast-5.amazonaws.com/spur-context-worker-lambda:latest"
source_fetcher_lambda_image = "123456789012.dkr.ecr.ap-southeast-5.amazonaws.com/spur-context-source-fetcher:latest"

# Lambda worker and source-fetcher sizing.
worker_lambda_memory_mb                     = 3008
worker_lambda_timeout_sec                   = 900
worker_lambda_ephemeral_storage_mb          = 10240
worker_lambda_provisioned_concurrency       = 0
source_fetcher_lambda_memory_mb             = 1024
source_fetcher_lambda_timeout_sec           = 900
source_fetcher_lambda_ephemeral_storage_mb = 10240

# Fetch-split handoff. The non-VPC source fetcher stages normalized archives
# under s3://<bucket>/fetch/<job_id>/source.tar.gz and returns a presigned HTTPS
# URL for the VPC worker. Keep this longer than the Lambda timeout plus ECS
# fallback window.
source_fetch_presign_seconds   = 21600
fetch_artifact_retention_days = 7
