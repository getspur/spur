# Partial S3 backend config for the original single-environment deployment.
#
# This is the de-facto env the live resources (account 065285885105, bucket
# spur-context) were first deployed under — it predates the staging/prod split,
# whose committed tfvars are still placeholders. Keep the live state here until
# a clean staging/prod deploy exists.
#
# The S3 bucket stores state; the DynamoDB table provides state locking.
bucket         = "wiilearn-spur-tfstate-apse5"
key            = "spur-context-service/default/terraform.tfstate"
region         = "ap-southeast-5"
dynamodb_table = "wiilearn-spur-tflocks"
encrypt        = true

# ap-southeast-5 (Malaysia) postdates terraform 1.5.7's embedded S3 backend
# region list; skip the static validation. Endpoint still resolves normally.
skip_region_validation      = true
skip_credentials_validation = true
skip_metadata_api_check     = true
