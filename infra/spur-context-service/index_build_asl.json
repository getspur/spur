{
  "StartAt": "RunLambdaBuild",
  "States": {
    "RunLambdaBuild": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${worker_lambda_timeout_sec},
      "Parameters": {
        "FunctionName": "${worker_lambda_arn}",
        "Payload": {
          "job_id.$": "$.job_id",
          "package.$": "$.package",
          "revision.$": "$.revision",
          "source.$": "$.source",
          "source_url.$": "$.source_url",
          "source_kind.$": "$.source_kind"
        }
      },
      "ResultPath": "$.lambdaResult",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout",
            "Lambda.Unknown",
            "Sandbox.Timedout",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "Next": "RunBuild",
          "ResultPath": "$.lambdaError"
        }
      ],
      "Next": "CheckLambdaBuild"
    },
    "CheckLambdaBuild": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.lambdaResult.Payload.status",
          "StringEquals": "complete",
          "Next": "Done"
        },
        {
          "Variable": "$.lambdaResult.Payload.status",
          "StringEquals": "failed",
          "Next": "LambdaBuildFailed"
        }
      ],
      "Default": "RunBuild"
    },
    "LambdaBuildFailed": {
      "Type": "Fail",
      "Error": "worker_failed",
      "Cause": "Lambda worker reported deterministic indexing failure"
    },
    "RunBuild": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.waitForTaskToken",
      "TimeoutSeconds": 3600,
      "Parameters": {
        "Cluster": "${cluster_arn}",
        "TaskDefinition": "${worker_taskdef_arn}",
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": "FARGATE_SPOT",
            "Weight": 4
          },
          {
            "CapacityProvider": "FARGATE",
            "Base": 0,
            "Weight": 1
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${subnets_json},
            "SecurityGroups": ${security_groups_json},
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "worker",
              "Environment": [
                {
                  "Name": "TASK_TOKEN",
                  "Value.$": "$$.Task.Token"
                },
                {
                  "Name": "JOB_ID",
                  "Value.$": "$.job_id"
                },
                {
                  "Name": "PACKAGE",
                  "Value.$": "$.package"
                },
                {
                  "Name": "REVISION",
                  "Value.$": "$.revision"
                },
                {
                  "Name": "SOURCE",
                  "Value.$": "$.source"
                },
                {
                  "Name": "SOURCE_URL",
                  "Value.$": "$.source_url"
                },
                {
                  "Name": "SOURCE_KIND",
                  "Value.$": "$.source_kind"
                },
                {
                  "Name": "SPUR_INDEX_JOBS_TABLE",
                  "Value": "${index_jobs_table_name}"
                },
                {
                  "Name": "SPUR_CATALOG_LEASES_TABLE",
                  "Value": "${catalog_leases_table_name}"
                },
                {
                  "Name": "SPUR_CATALOG_DSN",
                  "Value": "${catalog_dsn}"
                },
                {
                  "Name": "SPUR_CONTEXT_DUCKLAKE_DATA_PATH",
                  "Value": "${context_ducklake_data_path}"
                },
                {
                  "Name": "SPUR_CONTEXT_WORKER_CHECKPOINT_URI",
                  "Value.$": "States.Format('${worker_checkpoint_uri_template}', $.job_id)"
                }
              ]
            }
          ]
        },
        "PropagateTags": "TASK_DEFINITION"
      },
      "ResultPath": "$.buildStats",
      "Retry": [
        {
          "ErrorEquals": ["States.Timeout"],
          "MaxAttempts": 2,
          "BackoffRate": 2.0,
          "MaxDelaySeconds": 30
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "Next": "FallbackBuild",
          "ResultPath": "$.buildError"
        }
      ],
      "Next": "Done"
    },
    "FallbackBuild": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.waitForTaskToken",
      "TimeoutSeconds": 3600,
      "Parameters": {
        "Cluster": "${cluster_arn}",
        "TaskDefinition": "${worker_taskdef_arn}",
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": "FARGATE",
            "Weight": 1
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${subnets_json},
            "SecurityGroups": ${security_groups_json},
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "worker",
              "Environment": [
                {
                  "Name": "TASK_TOKEN",
                  "Value.$": "$$.Task.Token"
                },
                {
                  "Name": "JOB_ID",
                  "Value.$": "$.job_id"
                },
                {
                  "Name": "PACKAGE",
                  "Value.$": "$.package"
                },
                {
                  "Name": "REVISION",
                  "Value.$": "$.revision"
                },
                {
                  "Name": "SOURCE",
                  "Value.$": "$.source"
                },
                {
                  "Name": "SOURCE_URL",
                  "Value.$": "$.source_url"
                },
                {
                  "Name": "SOURCE_KIND",
                  "Value.$": "$.source_kind"
                },
                {
                  "Name": "SPUR_INDEX_JOBS_TABLE",
                  "Value": "${index_jobs_table_name}"
                },
                {
                  "Name": "SPUR_CATALOG_LEASES_TABLE",
                  "Value": "${catalog_leases_table_name}"
                },
                {
                  "Name": "SPUR_CATALOG_DSN",
                  "Value": "${catalog_dsn}"
                },
                {
                  "Name": "SPUR_CONTEXT_DUCKLAKE_DATA_PATH",
                  "Value": "${context_ducklake_data_path}"
                },
                {
                  "Name": "SPUR_CONTEXT_WORKER_CHECKPOINT_URI",
                  "Value.$": "States.Format('${worker_checkpoint_uri_template}', $.job_id)"
                }
              ]
            }
          ]
        },
        "PropagateTags": "TASK_DEFINITION"
      },
      "ResultPath": "$.buildStats",
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}
