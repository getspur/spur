{
  "StartAt": "RouteSource",
  "States": {
    "RouteSource": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.prefetch_source",
          "BooleanEquals": true,
          "Next": "FetchSource"
        }
      ],
      "Default": "PrepareOriginalWorkerInput"
    },
    "FetchSource": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${source_fetcher_lambda_timeout_sec},
      "Parameters": {
        "FunctionName": "${source_fetch_lambda_arn}",
        "Payload": {
          "job_id.$": "$.job_id",
          "package.$": "$.package",
          "revision.$": "$.revision",
          "source.$": "$.source",
          "source_url.$": "$.source_url",
          "source_kind.$": "$.source_kind",
          "limits.$": "$.limits"
        }
      },
      "ResultPath": "$.fetchResult",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "CheckFetchSource"
    },
    "CheckFetchSource": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.fetchResult.Payload.status",
          "StringEquals": "failed",
          "Next": "FetchSourceFailed"
        }
      ],
      "Default": "PrepareFetchedWorkerInput"
    },
    "FetchSourceFailed": {
      "Type": "Fail",
      "Error": "source_fetch_failed",
      "Cause": "Source fetcher reported deterministic source fetch failure"
    },
    "PrepareFetchedWorkerInput": {
      "Type": "Pass",
      "Parameters": {
        "job_id.$": "$.job_id",
        "package.$": "$.package",
        "revision.$": "$.revision",
        "source.$": "$.source",
        "source_url.$": "$.fetchResult.Payload.source_url",
        "source_kind.$": "$.fetchResult.Payload.source_kind",
        "limits.$": "$.limits"
      },
      "ResultPath": "$.workerInput",
      "Next": "RunLambdaBuild"
    },
    "PrepareOriginalWorkerInput": {
      "Type": "Pass",
      "Parameters": {
        "job_id.$": "$.job_id",
        "package.$": "$.package",
        "revision.$": "$.revision",
        "source.$": "$.source",
        "source_url.$": "$.source_url",
        "source_kind.$": "$.source_kind",
        "limits.$": "$.limits"
      },
      "ResultPath": "$.workerInput",
      "Next": "RunLambdaBuild"
    },
    "RunLambdaBuild": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": ${worker_lambda_timeout_sec},
      "Parameters": {
        "FunctionName": "${worker_lambda_arn}",
        "Payload": {
          "job_id.$": "$.workerInput.job_id",
          "package.$": "$.workerInput.package",
          "revision.$": "$.workerInput.revision",
          "source.$": "$.workerInput.source",
          "source_url.$": "$.workerInput.source_url",
          "source_kind.$": "$.workerInput.source_kind",
          "limits.$": "$.workerInput.limits"
        }
      },
      "ResultPath": "$.lambdaResult",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout",
            "Lambda.Unknown",
            "Sandbox.Timedout",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "Next": "RunBuild",
          "ResultPath": "$.lambdaError"
        }
      ],
      "Next": "CheckLambdaBuild"
    },
    "CheckLambdaBuild": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.lambdaResult.Payload.status",
          "StringEquals": "complete",
          "Next": "Done"
        },
        {
          "Variable": "$.lambdaResult.Payload.status",
          "StringEquals": "failed",
          "Next": "LambdaBuildFailed"
        }
      ],
      "Default": "RunBuild"
    },
    "LambdaBuildFailed": {
      "Type": "Fail",
      "Error": "worker_failed",
      "Cause": "Lambda worker reported deterministic indexing failure"
    },
    "RunBuild": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.waitForTaskToken",
      "TimeoutSeconds": ${worker_ecs_timeout_sec},
      "Parameters": {
        "Cluster": "${cluster_arn}",
        "TaskDefinition": "${worker_taskdef_arn}",
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": "FARGATE_SPOT",
            "Weight": 4
          },
          {
            "CapacityProvider": "FARGATE",
            "Base": 0,
            "Weight": 1
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${subnets_json},
            "SecurityGroups": ${security_groups_json},
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "worker",
              "Environment": [
                {
                  "Name": "TASK_TOKEN",
                  "Value.$": "$$.Task.Token"
                },
                {
                  "Name": "JOB_ID",
                  "Value.$": "$.workerInput.job_id"
                },
                {
                  "Name": "PACKAGE",
                  "Value.$": "$.workerInput.package"
                },
                {
                  "Name": "REVISION",
                  "Value.$": "$.workerInput.revision"
                },
                {
                  "Name": "SOURCE",
                  "Value.$": "$.workerInput.source"
                },
                {
                  "Name": "SOURCE_URL",
                  "Value.$": "$.workerInput.source_url"
                },
                {
                  "Name": "SOURCE_KIND",
                  "Value.$": "$.workerInput.source_kind"
                },
                {
                  "Name": "SPUR_INDEX_JOBS_TABLE",
                  "Value": "${index_jobs_table_name}"
                },
                {
                  "Name": "SPUR_CATALOG_LEASES_TABLE",
                  "Value": "${catalog_leases_table_name}"
                },
                {
                  "Name": "SPUR_CATALOG_DSN",
                  "Value": "${catalog_dsn}"
                },
                {
                  "Name": "SPUR_CONTEXT_DUCKLAKE_DATA_PATH",
                  "Value": "${context_ducklake_data_path}"
                },
                {
                  "Name": "SPUR_CONTEXT_MAX_SOURCE_BYTES",
                  "Value.$": "States.Format('{}', $.workerInput.limits.max_source_bytes)"
                },
                {
                  "Name": "SPUR_CONTEXT_MAX_BUILD_SECONDS",
                  "Value.$": "States.Format('{}', $.workerInput.limits.max_build_seconds)"
                },
                {
                  "Name": "SPUR_CONTEXT_WORKER_CHECKPOINT_URI",
                  "Value.$": "States.Format('${worker_checkpoint_uri_template}', $.workerInput.job_id)"
                }
              ]
            }
          ]
        },
        "PropagateTags": "TASK_DEFINITION"
      },
      "ResultPath": "$.buildStats",
      "Retry": [
        {
          "ErrorEquals": ["States.Timeout"],
          "MaxAttempts": 2,
          "BackoffRate": 2.0,
          "MaxDelaySeconds": 30
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "Next": "FallbackBuild",
          "ResultPath": "$.buildError"
        }
      ],
      "Next": "Done"
    },
    "FallbackBuild": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.waitForTaskToken",
      "TimeoutSeconds": ${worker_ecs_timeout_sec},
      "Parameters": {
        "Cluster": "${cluster_arn}",
        "TaskDefinition": "${worker_taskdef_arn}",
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": "FARGATE",
            "Weight": 1
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${subnets_json},
            "SecurityGroups": ${security_groups_json},
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "worker",
              "Environment": [
                {
                  "Name": "TASK_TOKEN",
                  "Value.$": "$$.Task.Token"
                },
                {
                  "Name": "JOB_ID",
                  "Value.$": "$.workerInput.job_id"
                },
                {
                  "Name": "PACKAGE",
                  "Value.$": "$.workerInput.package"
                },
                {
                  "Name": "REVISION",
                  "Value.$": "$.workerInput.revision"
                },
                {
                  "Name": "SOURCE",
                  "Value.$": "$.workerInput.source"
                },
                {
                  "Name": "SOURCE_URL",
                  "Value.$": "$.workerInput.source_url"
                },
                {
                  "Name": "SOURCE_KIND",
                  "Value.$": "$.workerInput.source_kind"
                },
                {
                  "Name": "SPUR_INDEX_JOBS_TABLE",
                  "Value": "${index_jobs_table_name}"
                },
                {
                  "Name": "SPUR_CATALOG_LEASES_TABLE",
                  "Value": "${catalog_leases_table_name}"
                },
                {
                  "Name": "SPUR_CATALOG_DSN",
                  "Value": "${catalog_dsn}"
                },
                {
                  "Name": "SPUR_CONTEXT_DUCKLAKE_DATA_PATH",
                  "Value": "${context_ducklake_data_path}"
                },
                {
                  "Name": "SPUR_CONTEXT_MAX_SOURCE_BYTES",
                  "Value.$": "States.Format('{}', $.workerInput.limits.max_source_bytes)"
                },
                {
                  "Name": "SPUR_CONTEXT_MAX_BUILD_SECONDS",
                  "Value.$": "States.Format('{}', $.workerInput.limits.max_build_seconds)"
                },
                {
                  "Name": "SPUR_CONTEXT_WORKER_CHECKPOINT_URI",
                  "Value.$": "States.Format('${worker_checkpoint_uri_template}', $.workerInput.job_id)"
                }
              ]
            }
          ]
        },
        "PropagateTags": "TASK_DEFINITION"
      },
      "ResultPath": "$.buildStats",
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}
