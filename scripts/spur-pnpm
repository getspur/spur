#!/usr/bin/env bash
# spur-pnpm — compatibility wrapper after the notebook repo split.
#
# Notebook frontend ownership moved to https://github.com/getspur/spur-notebook.
# Set SPUR_NOTEBOOK_REPO to a local standalone checkout if you want this wrapper
# to forward pnpm commands there.
set -euo pipefail

PNPM_ARGS=("$@")
if [[ "${PNPM_ARGS[0]:-}" == "--" ]]; then
    PNPM_ARGS=("${PNPM_ARGS[@]:1}")
fi

if [[ -n "${SPUR_NOTEBOOK_REPO:-}" ]]; then
    FRONTEND_DIR="$SPUR_NOTEBOOK_REPO/jute-notebook"
    if [[ ! -d "$FRONTEND_DIR" ]]; then
        echo "[spur-pnpm] SPUR_NOTEBOOK_REPO does not contain jute-notebook: $SPUR_NOTEBOOK_REPO" >&2
        exit 2
    fi
    exec pnpm --dir "$FRONTEND_DIR" "${PNPM_ARGS[@]}"
fi

cat >&2 <<'EOF'
[spur-pnpm] Notebook frontend commands now live in getspur/spur-notebook.

Use a standalone checkout:
  git clone https://github.com/getspur/spur-notebook
  cd spur-notebook
  pnpm --dir jute-notebook <command>

Or forward this wrapper:
  SPUR_NOTEBOOK_REPO=/path/to/spur-notebook scripts/spur-pnpm <command>
EOF
exit 2
