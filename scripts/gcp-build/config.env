# Shared configuration for SPUR remote-build scripts.
# Source this file from the other scripts: `source "$(dirname "$0")/config.env"`.

: "${GCP_PROJECT:=wiilearn}"
# Singapore for dev team in Vietnam — RTT ~30-50ms vs ~200ms to us-central1.
: "${GCP_REGION:=asia-southeast1}"
: "${GCP_ZONE:=asia-southeast1-a}"

# Globally-unique GCS bucket for sccache objects (region-pinned).
: "${SCCACHE_BUCKET:=${GCP_PROJECT}-spur-sccache-asia}"

# Persistent disk that survives spot preemption. Holds target/ + cargo registry.
# Sizing (measured 2026-05-29): targets/main ~70G + each concurrent per-delegation
# worktree target ~38G. At 200G, 2-3 concurrent workers cross the 70% disk
# watchdog (startup.sh), which prunes idle worktrees mid-build → cold rebuilds +
# IO churn. 300G holds main + ~3 worktrees with headroom (~60% used at peak); use
# 400G+ for >3 concurrent workers. NOTE: bumping this only affects NEWLY spun
# disks. To grow the EXISTING disk live:
#   gcloud compute disks resize spur-cargo-cache --size=300 --zone=asia-southeast1-a
#   then on the VM: sudo resize2fs /dev/sdb   (online, ext4 — no downtime)
#
# hyperdisk-balanced is the production default for the remote Rust workspace:
# on c4d-highcpu-16 it benchmarked faster than the previous pd-ssd cache while
# costing less for the 300G cache disk. A 300G Hyperdisk Balanced disk currently
# provisions 4,800 IOPS by default in GCE, which is enough for the observed cargo
# cache workload; leave throughput at the baseline unless the benchmark changes.
: "${CACHE_DISK:=spur-cargo-cache}"
: "${CACHE_DISK_SIZE_GB:=300}"
: "${CACHE_DISK_TYPE:=hyperdisk-balanced}"

# Build VM.
: "${VM_NAME:=spur-builder}"
# c4d-highcpu-16: 16 vCPU / 30 GB RAM. It fits the current project-wide
# CPUS_ALL_REGIONS=32 quota and measured faster than the previous c2d-highcpu-16
# builder for SPUR's Rust workspace. c4d-highcpu-32 is the next meaningful
# speedup target once quota permits it.
: "${VM_MACHINE_TYPE:=c4d-highcpu-16}"
: "${VM_BOOT_DISK_SIZE_GB:=50}"
: "${VM_BOOT_DISK_TYPE:=hyperdisk-balanced}"
: "${VM_IMAGE_FAMILY:=debian-12}"
: "${VM_IMAGE_PROJECT:=debian-cloud}"

# Direct SSH transport for source sync. IAP remains the fallback and still uses
# the standard GCE path. Direct mode defaults to the standard SSH port, with
# SPUR_DIRECT_SSH_PORT available for explicit alternate-port testing.
: "${SPUR_DIRECT_SSH:=1}"
: "${SPUR_DIRECT_SSH_PORT:=22}"

# Service account used by the VM to read/write the sccache bucket.
: "${BUILD_SA_NAME:=spur-builder}"
: "${BUILD_SA_EMAIL:=${BUILD_SA_NAME}@${GCP_PROJECT}.iam.gserviceaccount.com}"

# Local repo root (the directory containing Cargo.toml).
: "${SPUR_ROOT:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)}"

# Pin gcloud to a Python interpreter that has NumPy. gcloud's IAP tunnel
# uses pure-Python TCP buffer copies by default — observed ~3.5 KB/s upload
# throughput, making rsync to the VM unusable. With NumPy installed the
# tunnel uses C-accelerated copies (orders of magnitude faster).
# python3.13 ships with NumPy via Homebrew; python3.14 has a broken pyexpat
# and can't load numpy at all.
: "${CLOUDSDK_PYTHON:=/opt/homebrew/bin/python3.13}"
# gcloud runs python with -S (no site-packages) by default, hiding the
# Homebrew-installed numpy. Force it on so the IAP tunnel actually finds it.
: "${CLOUDSDK_PYTHON_SITEPACKAGES:=1}"

export GCP_PROJECT GCP_REGION GCP_ZONE SCCACHE_BUCKET CACHE_DISK \
    CACHE_DISK_SIZE_GB CACHE_DISK_TYPE VM_NAME VM_MACHINE_TYPE \
    VM_BOOT_DISK_SIZE_GB VM_BOOT_DISK_TYPE VM_IMAGE_FAMILY VM_IMAGE_PROJECT \
    BUILD_SA_NAME BUILD_SA_EMAIL SPUR_ROOT CLOUDSDK_PYTHON \
    CLOUDSDK_PYTHON_SITEPACKAGES SPUR_DIRECT_SSH SPUR_DIRECT_SSH_PORT
