# Shared capture geometry for SPUR demo / live TUI recordings.
#
# Target host: MacBook Air M2 Liquid Retina (2560x1664), wide iTerm2 layout
# (~200 columns x ~50 rows at Monaco-class fonts).
#
# Override any value in the environment before render/capture.
# Source this file from render/capture scripts:
#   # shellcheck disable=SC1091
#   source "$(dirname "$0")/../geometry.env"  # from tui-live/
#   source "$(dirname "$0")/../geometry.env"  # from tui-journeys/
#   source "$(dirname "$0")/../geometry.env"  # from context-service/

# shell-use PTY size (TUI layout columns/rows)
: "${SPUR_DEMO_COLS:=200}"
: "${SPUR_DEMO_ROWS:=50}"

# VHS pixel canvas (near-native Air width; 1600 tall ≈ 16:10 Retina)
: "${SPUR_VHS_WIDTH:=2560}"
: "${SPUR_VHS_HEIGHT:=1600}"
: "${SPUR_VHS_FONT_SIZE:=18}"
: "${SPUR_VHS_PADDING:=10}"
: "${SPUR_VHS_THEME:=Catppuccin Mocha}"
: "${SPUR_VHS_FRAMERATE:=24}"

# asciinema/agg re-render of shell-use casts
: "${SPUR_AGG_COLS:=${SPUR_DEMO_COLS}}"
: "${SPUR_AGG_ROWS:=${SPUR_DEMO_ROWS}}"
: "${SPUR_AGG_SPEED:=2.5}"
: "${SPUR_AGG_IDLE_LIMIT:=1.5}"

export SPUR_DEMO_COLS SPUR_DEMO_ROWS
export SPUR_VHS_WIDTH SPUR_VHS_HEIGHT SPUR_VHS_FONT_SIZE SPUR_VHS_PADDING
export SPUR_VHS_THEME SPUR_VHS_FRAMERATE
export SPUR_AGG_COLS SPUR_AGG_ROWS SPUR_AGG_SPEED SPUR_AGG_IDLE_LIMIT
