#!/usr/bin/env python3
"""Authenticate gcloud and start local SPUR sccache GCS credentials.

This script keeps long-lived service-account keys out of the local machine.
It serves short-lived gcloud access tokens on localhost for sccache's
SCCACHE_GCS_CREDENTIALS_URL support.
"""

from __future__ import annotations

import argparse
import datetime as dt
import http.server
import json
import os
import pathlib
import signal
import socket
import subprocess
import sys
import time
from typing import Mapping


PROJECT = os.environ.get("GCP_PROJECT", "wiilearn")
BUCKET = os.environ.get("SCCACHE_BUCKET", f"{PROJECT}-spur-sccache-asia")
SERVICE_ACCOUNT = os.environ.get(
    "SPUR_SCCACHE_SERVICE_ACCOUNT",
    f"spur-sccache-local@{PROJECT}.iam.gserviceaccount.com",
)
PORT = int(os.environ.get("SPUR_SCCACHE_TOKEN_PORT", "8768"))
HOST = os.environ.get("SPUR_SCCACHE_TOKEN_HOST", "127.0.0.1")
TOKEN_URL = os.environ.get(
    "SPUR_SCCACHE_GCS_CREDENTIALS_URL",
    f"http://{HOST}:{PORT}/token",
)
STATE_DIR = pathlib.Path(
    os.environ.get(
        "SPUR_GCLOUD_AUTH_STATE_DIR",
        pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state"))
        / "spur"
        / "gcloud-auth",
    )
)
PID_FILE = STATE_DIR / "token-server.pid"
LOG_FILE = STATE_DIR / "token-server.log"


def run(args: list[str], env: Mapping[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, env=env, text=True, check=True)


def token_payload() -> dict[str, str]:
    try:
        token = subprocess.check_output(
            [
                "gcloud",
                "auth",
                "print-access-token",
                f"--impersonate-service-account={SERVICE_ACCOUNT}",
            ],
            stderr=subprocess.PIPE,
            text=True,
        ).strip()
    except subprocess.CalledProcessError as exc:
        if exc.stderr:
            print(exc.stderr, file=sys.stderr, end="")
        raise RuntimeError("gcloud token refresh failed; run scripts/gcloud_auth auth") from exc
    expire_time = dt.datetime.now(dt.timezone.utc) + dt.timedelta(minutes=50)
    return {
        "accessToken": token,
        "expireTime": expire_time.replace(microsecond=0).isoformat().replace("+00:00", "Z"),
    }


class TokenHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self) -> None:  # noqa: N802 - stdlib callback name
        if self.path != "/token":
            self.send_error(404)
            return
        try:
            body = json.dumps(token_payload()).encode("utf-8")
        except Exception as exc:  # pragma: no cover - exercised by real gcloud failures.
            self.send_error(500, str(exc))
            return
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, _format: str, *_args: object) -> None:
        return


def is_pid_running(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def read_pid() -> int | None:
    try:
        return int(PID_FILE.read_text().strip())
    except (FileNotFoundError, ValueError):
        return None


def token_endpoint_ok(timeout: float = 0.5) -> bool:
    try:
        with socket.create_connection((HOST, PORT), timeout=timeout) as sock:
            request = f"GET /token HTTP/1.0\r\nHost: {HOST}\r\n\r\n".encode("ascii")
            sock.sendall(request)
            return b"200 OK" in sock.recv(256)
    except OSError:
        return False


def serve_token() -> int:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    server = http.server.ThreadingHTTPServer((HOST, PORT), TokenHandler)
    server.serve_forever()
    return 0


def start_token_service() -> int:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    pid = read_pid()
    if pid is not None and is_pid_running(pid) and token_endpoint_ok():
        print(f"token endpoint already running at {TOKEN_URL}")
        return 0

    with LOG_FILE.open("ab") as log:
        proc = subprocess.Popen(
            [sys.executable, __file__, "serve-token"],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            start_new_session=True,
        )
    PID_FILE.write_text(f"{proc.pid}\n")

    for _ in range(40):
        if proc.poll() is not None:
            print(f"token endpoint exited early; see {LOG_FILE}", file=sys.stderr)
            return proc.returncode or 1
        if token_endpoint_ok():
            print(f"token endpoint running at {TOKEN_URL}")
            return 0
        time.sleep(0.25)

    print(f"token endpoint did not become ready; see {LOG_FILE}", file=sys.stderr)
    return 1


def stop_token_service() -> int:
    pid = read_pid()
    if pid is not None and is_pid_running(pid):
        os.kill(pid, signal.SIGTERM)
        for _ in range(20):
            if not is_pid_running(pid):
                break
            time.sleep(0.1)
    try:
        PID_FILE.unlink()
    except FileNotFoundError:
        pass
    return 0


def sccache_env() -> dict[str, str]:
    env = os.environ.copy()
    env.setdefault("SCCACHE_IDLE_TIMEOUT", "0")
    env["SCCACHE_DIR"] = os.environ.get(
        "SPUR_SCCACHE_DIR",
        os.environ.get("SCCACHE_DIR", str(pathlib.Path.home() / "Library/Caches/Mozilla.sccache")),
    )
    env["SCCACHE_CACHE_SIZE"] = os.environ.get(
        "SPUR_SCCACHE_CACHE_SIZE", os.environ.get("SCCACHE_CACHE_SIZE", "10G")
    )
    env["SCCACHE_MULTILEVEL_CHAIN"] = os.environ.get(
        "SPUR_SCCACHE_MULTILEVEL_CHAIN", os.environ.get("SCCACHE_MULTILEVEL_CHAIN", "disk,gcs")
    )
    env["SCCACHE_MULTILEVEL_WRITE_ERROR_POLICY"] = os.environ.get(
        "SPUR_SCCACHE_MULTILEVEL_WRITE_ERROR_POLICY",
        os.environ.get("SCCACHE_MULTILEVEL_WRITE_ERROR_POLICY", "ignore"),
    )
    env["SCCACHE_GCS_BUCKET"] = BUCKET
    env["SCCACHE_GCS_RW_MODE"] = os.environ.get(
        "SPUR_SCCACHE_GCS_RW_MODE", os.environ.get("SCCACHE_GCS_RW_MODE", "READ_WRITE")
    )
    env["SCCACHE_GCS_CREDENTIALS_URL"] = TOKEN_URL
    env.setdefault("SCCACHE_ERROR_LOG", os.environ.get("SCCACHE_ERROR_LOG", "/tmp/spur-sccache-gcs-local.log"))
    return env


def start_sccache() -> int:
    env = sccache_env()
    subprocess.run(["sccache", "--stop-server"], env=env, text=True)
    subprocess.run(["sccache", "--start-server"], env=env, text=True, check=True)
    print("sccache local disk,gcs cache started")
    return 0


def status() -> int:
    pid = read_pid()
    token_state = "stopped"
    if pid is not None and is_pid_running(pid):
        token_state = "ready" if token_endpoint_ok() else "running"
    print(f"token endpoint: {token_state} ({TOKEN_URL})")
    subprocess.run(["sccache", "--show-stats"], text=True)
    return 0


def auth() -> int:
    run(["gcloud", "auth", "login", "--update-adc"])
    return start()


def start() -> int:
    token_rc = start_token_service()
    if token_rc != 0:
        return token_rc
    return start_sccache()


def stop() -> int:
    stop_token_service()
    subprocess.run(["sccache", "--stop-server"], text=True)
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "command",
        nargs="?",
        default="auth",
        choices=["auth", "start", "start-sccache", "serve-token", "status", "stop", "token"],
    )
    args = parser.parse_args(argv)

    try:
        if args.command == "auth":
            return auth()
        if args.command == "start":
            return start()
        if args.command == "start-sccache":
            return start_sccache()
        if args.command == "serve-token":
            return serve_token()
        if args.command == "status":
            return status()
        if args.command == "stop":
            return stop()
        if args.command == "token":
            print(json.dumps(token_payload()))
            return 0
    except RuntimeError as exc:
        print(f"gcloud_auth: {exc}", file=sys.stderr)
        return 1
    raise AssertionError(args.command)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except RuntimeError as exc:
        print(f"gcloud_auth: {exc}", file=sys.stderr)
        raise SystemExit(1)
