#!/usr/bin/env bash
# spur-cargo — project-standard cargo wrapper.
#
# Injects scripts/sccache-worktree.sh as RUSTC_WRAPPER unless the caller already
# set RUSTC_WRAPPER. Keeping this out of .cargo/config.toml prevents cargo-dist
# and Windows CI from inheriting a Unix shell wrapper.
#
# See: docs/rca/2026-04-27-sccache-worktree-cache-miss.md
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="${SCRIPT_PATH%/*}"
if [[ "$SCRIPT_DIR" == "$SCRIPT_PATH" ]]; then
    SCRIPT_DIR="."
fi
SCRIPT_DIR=$(cd "$SCRIPT_DIR" && pwd -P)
WRAPPER="$SCRIPT_DIR/sccache-worktree.sh"

if [[ -z "${RUSTC_WRAPPER+x}" ]]; then
    export RUSTC_WRAPPER="$WRAPPER"
fi

exec cargo "$@"
