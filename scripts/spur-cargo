#!/usr/bin/env bash
# spur-cargo — project-standard cargo wrapper.
#
# Previously ran sccache-sync-basedirs.sh to enumerate worktrees in the
# server's SCCACHE_BASEDIRS. This is now handled dynamically by
# scripts/sccache-worktree.sh (set as rustc-wrapper in .cargo/config.toml),
# so this wrapper is a thin pass-through kept for backward compatibility.
#
# See: docs/rca/2026-04-27-sccache-worktree-cache-miss.md
set -euo pipefail

exec cargo "$@"
